{
  "buildCommand": "npm run fixture && npm run registry && npm run web:build",
  "outputDirectory": "public",
  "functions": {
    "api/index.ts": {
      "includeFiles": "{data,content}/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
