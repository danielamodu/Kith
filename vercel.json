{
  "buildCommand": "npm run fixture && npm run registry && npm run web:build && node scripts/build-api.mjs",
  "functions": {
    "api/index.js": {
      "includeFiles": "{data,content,public}/**",
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/poll",
      "schedule": "0 6 * * *"
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ]
}