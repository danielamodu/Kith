{
  "name": "kith",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Mind that remembers every member of your community, and tells you what you can't see anymore.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "fixture": "node src/fixture.ts",
    "ingest": "node src/cli-ingest.ts",
    "detect": "node src/cli-detect.ts",
    "registry": "node src/cli-registry.ts",
    "calibrate": "node src/calibrate.ts",
    "backfill": "node src/cli-backfill.ts",
    "poll": "node src/cli-poll.ts",
    "discord": "node src/cli-discord.ts",
    "push": "node src/cli-push.ts",
    "setup": "node src/cli-setup.ts",
    "web": "node src/server.ts",
    "web:dev": "node --watch src/server.ts",
    "web:build": "npm --prefix frontend install --legacy-peer-deps && npm --prefix frontend run build && node scripts/deploy-frontend.ts",
    "pretest": "node src/fixture.ts",
    "test": "node --test \"src/*.test.ts\""
  },
  "dependencies": {
    "@animocabrands/minds-client-lib": "^0.1.3",
    "cors": "^2.8.6",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "tweetnacl": "^1.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
