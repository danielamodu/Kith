# Copy to .env and fill in. Never commit the real .env — it is gitignored.
#
# Create a Builder API key in the Minds Builder console (name + expiry).
# The token is shown only once, so copy it when it appears.
MINDS_BUILDER_API_KEY=

# The Mind that holds the registry and runs the cadence cycles.
# Find it with: minds list --pretty
KITH_MIND_ID=

# --- community sources (you need at least one) ---

# Telegram. Live traffic only — the Bot API cannot read history, so pair this
# with a Desktop JSON export via `npm run backfill`.
# BotFather: /newbot, then /setprivacy -> Disable, then RE-ADD the bot to the group.
# See docs/telegram-setup.md
TELEGRAM_BOT_TOKEN=

# Discord. Reads history directly, so no export step at all.
# Developer Portal -> Bot -> enable MESSAGE CONTENT INTENT, or every message
# arrives empty while everything appears to work.
# See docs/discord-setup.md
DISCORD_BOT_TOKEN=
