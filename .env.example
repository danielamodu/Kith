# Copy to .env and fill in. Never commit the real .env — it is gitignored.
#
# Create a Builder API key in the Minds Builder console (name + expiry).
# The token is shown only once, so copy it when it appears.
MINDS_BUILDER_API_KEY=

# The Mind that holds the registry and runs the cadence cycles.
# Find it with: minds list --pretty
KITH_MIND_ID=
